<?xml version="1.0"?>

<form>
    <group id="secret" colspan="4">
        <label name="name"/>
        <field name="name"/>
        <label name="value"/>
        <field name="value" widget="password"/>
    </group>

    <group id="custom_key" colspan="4">
        <label name="use_custom_key"/>
        <field name="use_custom_key"/>
        <label name="custom_key"/>
        <field name="custom_key" widget="password"/>
    </group>

    <group id="actions" colspan="4" col="-1">
        <button name="show_value"/>
        <button name="start_edit"/>
    </group>
</form>
