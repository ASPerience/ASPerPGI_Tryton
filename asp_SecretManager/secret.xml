<?xml version="1.0"?>
<tryton>
    <data>
        <!-- Secret Views and Actions -->
        <record model="ir.ui.view" id="view_secret_tree">
            <field name="model">secret.secret</field>
            <field name="type">tree</field>
            <field name="name">secret_tree</field>
        </record>

        <record model="ir.ui.view" id="view_secret_form">
            <field name="model">secret.secret</field>
            <field name="type">form</field>
            <field name="name">secret_form</field>
        </record>

        <record model="ir.action.act_window" id="act_secret">
            <field name="name">Secrets</field>
            <field name="res_model">secret.secret</field>
        </record>

        <record model="ir.action.act_window.view" id="act_secret_view_tree">
            <field name="sequence" eval="10"/>
            <field name="view" ref="view_secret_tree"/>
            <field name="act_window" ref="act_secret"/>
        </record>

        <record model="ir.action.act_window.view" id="act_secret_view_form">
            <field name="sequence" eval="20"/>
            <field name="view" ref="view_secret_form"/>
            <field name="act_window" ref="act_secret"/>
        </record>

        <!-- Buttons -->
        <record model="ir.model.button" id="secret_show_value_button">
            <field name="model">secret.secret</field>
            <field name="name">show_value</field>
            <field name="string">Afficher</field>
        </record>

        <record model="ir.model.button" id="secret_start_edit_button">
            <field name="model">secret.secret</field>
            <field name="name">start_edit</field>
            <field name="string">Modifier</field>
        </record>

        <record model="ir.model.button-res.group" id="secret_show_value_button_group">
            <field name="button" ref="secret_show_value_button"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.model.button-res.group" id="secret_start_edit_button_group">
            <field name="button" ref="secret_start_edit_button"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <!-- Key Generation View and Action-->

        <record model="ir.action.wizard" id="act_show_value">
            <field name="name">Afficher la valeur</field>
            <field name="wiz_name">secret.show</field>
            <field name="model">secret.secret</field>
        </record>

        <record model="ir.action.wizard" id="act_edit_value">
            <field name="name">Modifier la valeur</field>
            <field name="wiz_name">secret.edit</field>
            <field name="model">secret.secret</field>
        </record>

        <record model="ir.action.wizard" id="act_generate_key">
            <field name="name">Générer une clé</field>
            <field name="wiz_name">secret.generate</field>
        </record>

        <record model="ir.ui.view" id="show_value_ask_view">
            <field name="model">secret.show.ask</field>
            <field name="type">form</field>
            <field name="name">show_value_ask_view</field>
        </record>

        <record model="ir.ui.view" id="show_value_result_view">
            <field name="model">secret.show.result</field>
            <field name="type">form</field>
            <field name="name">show_value_result_view</field>
        </record>

        <record model="ir.ui.view" id="edit_value_start_view">
            <field name="model">secret.edit.start</field>
            <field name="type">form</field>
            <field name="name">edit_value_start_view</field>
        </record>

        <record model="ir.ui.view" id="generate_key_view">
            <field name="model">secret.generate.start</field>
            <field name="type">form</field>
            <field name="name">generate_key_view</field>
        </record>

        <!-- Menu Item -->
        <menuitem
            name="Secrets"
            parent="menu_secret_root"
            action="act_secret"
            id="menu_secret_list"
            icon="tryton-list"/>

        <menuitem
            name="Générer une clé"
            parent="menu_secret_root"
            action="act_generate_key"
            id="menu_generate_key"/>

        <record model="ir.action.wizard" id="act_rotate_key">
            <field name="name">Rechiffrer les secrets</field>
            <field name="wiz_name">secret.rotate</field>
        </record>

        <record model="ir.ui.view" id="rotate_key_start_view">
            <field name="model">secret.rotate.start</field>
            <field name="type">form</field>
            <field name="name">rotate_key_start_view</field>
        </record>

        <record model="ir.ui.view" id="rotate_key_result_view">
            <field name="model">secret.rotate.result</field>
            <field name="type">form</field>
            <field name="name">rotate_key_result_view</field>
        </record>

        <menuitem
            name="Rechiffrer les secrets"
            parent="menu_secret_root"
            action="act_rotate_key"
            id="menu_rotate_key"
            sequence="90"/>

        <!-- Action Protection -->
        <record model="ir.action-res.group" id="act_secret_group">
            <field name="action" ref="act_secret"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <!-- Wizard Protection -->
        <record model="ir.action-res.group" id="wizard_show_value_group">
            <field name="action" ref="act_show_value"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.action-res.group" id="wizard_edit_value_group">
            <field name="action" ref="act_edit_value"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.action-res.group" id="wizard_generate_key_group">
            <field name="action" ref="act_generate_key"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.action-res.group" id="wizard_rotate_key_group">
            <field name="action" ref="act_rotate_key"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <!-- Menu Protection-->
        <record model="ir.ui.menu-res.group" id="menu_secret_root_group">
            <field name="menu" ref="menu_secret_root"/>
            <field name="group" ref="group_secret_manager"/>
        </record>

        <record model="ir.ui.menu-res.group" id="menu_secret_list_group">
            <field name="menu" ref="menu_secret_list"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.ui.menu-res.group" id="menu_generate_key_group">
            <field name="menu" ref="menu_generate_key"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <record model="ir.ui.menu-res.group" id="menu_rotate_key_group">
            <field name="menu" ref="menu_rotate_key"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>

        <!-- Model Access - Secret -->
        <record model="ir.model.access" id="access_secret_user">
            <field name="model">secret.secret</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <record model="ir.model.access" id="access_secret">
            <field name="model">secret.secret</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
            <field name="group" ref="group_secret_manager"/>
        </record>

        <record model="ir.model.access" id="access_secret_admin">
            <field name="model">secret.secret</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
            <field name="group" ref="group_secret_manager_admin"/>
        </record>
    </data>
</tryton>
